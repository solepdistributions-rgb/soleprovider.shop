<section class="drops-feature" id="current-drop" data-drops-section="{{ section.id }}">
  <div class="page-width">
    <div class="drops-feature__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="drops-feature__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="drops-feature__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="drops-feature__text rte">{{ section.settings.text }}</div>
      {% endif %}
    </div>

    {% assign drop_count = 0 %}
    <div class="drops-grid">
      {% for block in section.blocks %}
        {% assign featured_product = all_products[block.settings.product] %}
        {% if featured_product != blank %}
          {% assign drop_count = drop_count | plus: 1 %}

          {%- comment -%} Find the colour option and build a colour -> image map. {%- endcomment -%}
          {% assign color_option = null %}
          {% for opt in featured_product.options_with_values %}
            {% if opt.name == 'Color' or opt.name == 'Colour' %}
              {% assign color_option = opt %}
            {% endif %}
          {% endfor %}

          <div class="drops-card" {{ block.shopify_attributes }} data-drops-card>
            <a class="drops-card__media" href="{{ featured_product.url }}" data-drops-link>
              {% if block.settings.badge_text != blank %}
                <span class="drops-card__badge">{{ block.settings.badge_text }}</span>
              {% endif %}

              {% if featured_product.featured_image != blank %}
                <img
                  src="{{ featured_product.featured_image | image_url: width: 1200 }}"
                  alt="{{ featured_product.title | escape }}"
                  loading="lazy"
                  width="{{ featured_product.featured_image.width }}"
                  height="{{ featured_product.featured_image.height }}"
                  data-drops-img
                >
              {% else %}
                <span class="drops-card__placeholder">{{ featured_product.title }}</span>
              {% endif %}
            </a>

            <div class="drops-card__body">
              <h3 class="drops-card__title">
                <a href="{{ featured_product.url }}" data-drops-link>{{ featured_product.title }}</a>
              </h3>

              <div class="drops-card__price">
                {% render 'price', product: featured_product, use_variant: false, show_badges: false %}
              </div>

              {% if color_option %}
                <div class="drops-card__swatches" role="group" aria-label="Colours for {{ featured_product.title | escape }}">
                  {% for value in color_option.values %}
                    <button
                      type="button"
                      class="drops-card__swatch{% if forloop.first %} is-active{% endif %}"
                      data-drops-swatch
                      data-color="{{ value | escape }}"
                      title="{{ value | escape }}"
                      aria-label="{{ value | escape }}"
                      {% if value.swatch.color %}style="--swatch: {{ value.swatch.color }};"{% endif %}
                    ></button>
                  {% endfor %}
                </div>

                <p class="drops-card__color-name" data-drops-color-name>
                  {{ color_option.values.first }}
                </p>
              {% endif %}

              <script type="application/json" data-drops-data>
                {{ featured_product.variants | json }}
              </script>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if drop_count == 0 %}
      <div class="drops-feature__empty">
        <h3>No drop selected yet</h3>
        <p>Add a product block in the theme editor to feature it here.</p>
      </div>
    {% endif %}

    {% if section.settings.note != blank %}
      <p class="drops-feature__note">{{ section.settings.note }}</p>
    {% endif %}
  </div>
</section>

<style>
  .drops-feature {
    padding: 84px 0;
    background: #ffffff;
    color: #111111;
  }

  .drops-feature__intro {
    max-width: 760px;
    margin: 0 auto 40px;
    text-align: center;
  }

  .drops-feature__eyebrow {
    margin: 0 0 10px;
    color: #c41230;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .drops-feature__heading {
    margin: 0 0 12px;
    font-family: var(--sole-heading-font);
    font-size: clamp(2.9rem, 4vw, 5rem);
    line-height: 0.95;
    font-weight: 900;
    text-transform: uppercase;
    color: #111111;
  }

  .drops-feature__text {
    font-size: 1.55rem;
    color: #444444;
  }

  .drops-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 32px;
    align-items: start;
  }

  .drops-card {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid #e4e4e4;
    border-radius: 18px;
    overflow: hidden;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .drops-card:hover {
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.09);
    transform: translateY(-2px);
  }

  .drops-card__media {
    position: relative;
    display: block;
    background: #f4f4f4;
    aspect-ratio: 483 / 724;
  }

  .drops-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .drops-card__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 20px;
    text-align: center;
    color: #777777;
  }

  .drops-card__badge {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 1;
    padding: 6px 12px;
    border-radius: 999px;
    background: #c41230;
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .drops-card__body {
    padding: 20px 20px 24px;
  }

  .drops-card__title {
    margin: 0 0 6px;
    font-size: 1.9rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .drops-card__title a {
    color: #111111;
    text-decoration: none;
  }

  .drops-card__title a:hover {
    text-decoration: underline;
  }

  .drops-card__price {
    margin-bottom: 14px;
    font-size: 1.6rem;
    color: #333333;
  }

  .drops-card__swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 8px;
  }

  .drops-card__swatch {
    width: 30px;
    height: 30px;
    min-width: 30px;
    padding: 0;
    border: 1px solid #cccccc;
    border-radius: 50%;
    background: var(--swatch, #dddddd);
    cursor: pointer;
    outline-offset: 3px;
    transition: box-shadow 0.15s ease;
  }

  .drops-card__swatch.is-active {
    box-shadow: 0 0 0 2px #ffffff inset, 0 0 0 2px #111111;
  }

  .drops-card__color-name {
    margin: 0;
    font-size: 1.35rem;
    color: #666666;
  }

  .drops-feature__note {
    margin: 28px 0 0;
    text-align: center;
    font-size: 1.3rem;
    color: #777777;
  }

  .drops-feature__empty {
    text-align: center;
    color: #666666;
  }

  @media screen and (max-width: 749px) {
    .drops-feature {
      padding: 56px 0;
    }

    .drops-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    /* Comfortable tap targets on touch screens. */
    .drops-card__swatch {
      width: 34px;
      height: 34px;
      min-width: 34px;
    }
  }
</style>

<script>
  (function () {
    var section = document.querySelector('[data-drops-section="{{ section.id }}"]');
    if (!section) return;

    section.querySelectorAll('[data-drops-card]').forEach(function (card) {
      var dataEl = card.querySelector('[data-drops-data]');
      var img = card.querySelector('[data-drops-img]');
      var swatches = card.querySelectorAll('[data-drops-swatch]');
      var colorName = card.querySelector('[data-drops-color-name]');
      var links = card.querySelectorAll('[data-drops-link]');
      if (!dataEl || !swatches.length) return;

      var variants;
      try {
        variants = JSON.parse(dataEl.textContent);
      } catch (e) {
        return;
      }

      function firstVariantFor(color) {
        for (var i = 0; i < variants.length; i++) {
          if (variants[i].options.indexOf(color) !== -1) return variants[i];
        }
        return null;
      }

      function select(color, swatch) {
        var variant = firstVariantFor(color);
        if (!variant) return;

        if (img && variant.featured_image && variant.featured_image.src) {
          var src = variant.featured_image.src;
          if (src.slice(0, 2) === '//') src = 'https:' + src;
          src += (src.indexOf('?') === -1 ? '?' : '&') + 'width=1200';
          img.src = src;
          img.alt = variant.name || '';
        }

        if (colorName) colorName.textContent = color;

        // Deep-link into the product page on the chosen colour.
        links.forEach(function (link) {
          link.href = link.pathname + '?variant=' + variant.id;
        });

        swatches.forEach(function (s) { s.classList.remove('is-active'); });
        if (swatch) swatch.classList.add('is-active');
      }

      swatches.forEach(function (swatch) {
        swatch.addEventListener('click', function () {
          select(swatch.dataset.color, swatch);
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Exclusive Drops Feature",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Current Drop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the Current Release"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro text",
      "default": "<p>A featured Sole Provider release available to purchase directly while it lasts.</p>"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Small note",
      "default": "Limited quantities available. Product availability may change without notice."
    }
  ],
  "blocks": [
    {
      "type": "drop_product",
      "name": "Drop product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Exclusive Drops Feature",
      "blocks": [
        { "type": "drop_product" }
      ]
    }
  ]
}
{% endschema %}
